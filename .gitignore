docker/monitoring/alertmanager/alertmanager.yml

# Live-mutated runtime state, rewritten continuously by 24/7 governor/shadow loops --
# tracking these kept the working tree permanently dirty and silently disabled
# scripts/ops/deploy_watcher.sh's pull safety gate. Backed up separately by
# scripts/ops/backup_live_data.sh, not via git history.
data/ensemble/final_governor_runtime_state.json
data/ensemble/governor_live_state.json
data/ensemble/omega4_6_1_shadow_btc_state.json
data/ensemble/omega4_6_1_shadow_sol_state.json
data/ensemble/omega4_6_1_btc_multislot_shadow_state_20260807.json
data/ensemble/omega4_6_1_btc_multislot_shadow_state_20260807_regime.json

# .env backups can contain live API keys/tokens -- never track
.env.bak*
