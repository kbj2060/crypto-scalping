global:
  resolve_timeout: 5m

route:
  receiver: telegram
  group_by: ["alertname", "unit", "component"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 30m
  routes:
    - matchers:
        - severity="warning"
      repeat_interval: 120m

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: "__TELEGRAM_BOT_TOKEN__"
        chat_id: __TELEGRAM_CHAT_ID__
        api_url: https://api.telegram.org
        parse_mode: HTML
        message: |
          {{ if eq .Status "firing" }}🔴{{ else }}🟢{{ end }} <b>[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }}</b>
          {{ range .Alerts }}{{ .Annotations.summary }}
          {{ end }}
