[Unit]
Description=crypto-scalping trading_bot (live decision/shadow loop)
After=network-online.target
Wants=network-online.target
# Restart forever, never permanently give up (StartLimitIntervalSec=0 disables
# systemd's default "stop restarting after N crashes" behavior) -- this matches
# _supervise.sh's guarantee that the loop keeps trying. ops_watchdog's
# trading_bot_process check still pages immediately regardless.
StartLimitIntervalSec=0

[Service]
Type=simple
User=llewyn
WorkingDirectory=/home/llewyn/crypto-scalping
ExecStart=/home/llewyn/miniconda3/envs/quant_ai/bin/python -u /home/llewyn/crypto-scalping/trading_bot.py
Restart=always
# 2026-08-07: progressive backoff (15s -> ... -> 300s cap over 6 steps) so a fast
# crash-loop (bad deploy, revoked API key) doesn't hammer Binance every 15s
# forever -- still never gives up (StartLimitIntervalSec=0 above), just slows
# down. A one-off crash still recovers at the original 15s.
RestartSec=15
RestartSteps=6
RestartMaxDelaySec=300
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading_bot

[Install]
WantedBy=multi-user.target
