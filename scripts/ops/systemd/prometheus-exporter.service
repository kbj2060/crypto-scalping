[Unit]
Description=crypto-scalping Prometheus exporter (read-only, translates ops_watchdog state)
After=network-online.target ops-watchdog.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=llewyn
WorkingDirectory=/home/llewyn/crypto-scalping
ExecStart=/home/llewyn/miniconda3/envs/quant_ai/bin/python -u /home/llewyn/crypto-scalping/scripts/ops/prometheus_exporter.py --host 127.0.0.1 --port 9101
Restart=always
RestartSec=15
RestartSteps=6
RestartMaxDelaySec=300
StandardOutput=journal
StandardError=journal
SyslogIdentifier=prometheus_exporter

[Install]
WantedBy=multi-user.target
