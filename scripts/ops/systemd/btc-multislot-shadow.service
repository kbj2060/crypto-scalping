[Unit]
Description=crypto-scalping BTC multi-slot (N=3) shadow loop (2026-08-07, shadow-only, no order submission)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=llewyn
WorkingDirectory=/home/llewyn/crypto-scalping
ExecStart=/home/llewyn/miniconda3/envs/quant_ai/bin/python -u /home/llewyn/crypto-scalping/scripts/run_btc_multislot_shadow_loop_20260807.py
Restart=always
RestartSec=15
RestartSteps=6
RestartMaxDelaySec=300
StandardOutput=journal
StandardError=journal
SyslogIdentifier=btc_multislot_shadow

[Install]
WantedBy=multi-user.target
