{
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "ecc@ecc": false
  },
  "permissions": {
    "ask": [
      "Bash(rm *-r*)",
      "Bash(rm *-R*)",
      "Bash(git *reset --hard*)",
      "Bash(git *checkout -- *)",
      "Bash(git *checkout .*)",
      "Bash(git *checkout -f*)",
      "Bash(git *checkout --force*)",
      "Bash(git *restore *)",
      "Bash(git *clean -*f*)",
      "Bash(git *push*--force*)",
      "Bash(git *push -f*)",
      "Bash(git *push * -f*)",
      "Bash(git *push * +*)",
      "Bash(git *commit*--amend*)",
      "Bash(git *branch*-D*)",
      "Bash(git *branch*--delete*)",
      "Bash(git *stash drop*)",
      "Bash(git *stash clear*)",
      "Bash(git *stash pop*)",
      "Bash(git *reflog expire*)",
      "Bash(git *reflog delete*)",
      "Bash(git *update-ref -d*)",
      "Bash(git *rm -r*)",
      "Bash(git *rm -f*)",
      "Bash(*drop table*)",
      "Bash(*DROP TABLE*)",
      "Bash(*delete from*)",
      "Bash(*DELETE FROM*)",
      "Bash(*truncate*)",
      "Bash(*TRUNCATE*)",
      "Bash(*dd if=*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"; [ -f \"$f\" ] || f=/home/kbj20/crypto-scalping/.claude/hooks/guard.py; exec python3 \"$f\" pre",
            "timeout": 200
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"; [ -f \"$f\" ] || f=/home/kbj20/crypto-scalping/.claude/hooks/guard.py; exec python3 \"$f\" post",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
