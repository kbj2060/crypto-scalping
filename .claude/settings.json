{
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "ecc@ecc": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"; [ -f \"$f\" ] || f=/home/kbj20/crypto-scalping/.claude/hooks/guard.py; exec python3 \"$f\" pre",
            "timeout": 200
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"; [ -f \"$f\" ] || f=/home/kbj20/crypto-scalping/.claude/hooks/guard.py; exec python3 \"$f\" post",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
